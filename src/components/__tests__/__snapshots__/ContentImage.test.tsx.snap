          <View>
            <Text
              numberOfLines={2}
              style={
                {
                  "color": "#212121",
                  "fontFamily": "Ubuntu",
                  "fontSize": 12,
                  "fontStyle": "normal",
                  "fontWeight": "bold",
                  "lineHeight": 16,
                  "marginBottom": 4,
                }
              }
            >
              Title
            </Text>
          </View>
        </View>
      </View>
    </View>
  </View>
</View>
`;

